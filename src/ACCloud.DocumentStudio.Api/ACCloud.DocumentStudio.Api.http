@host = http://localhost:5176

### PDF desde plantilla con secciones (cabecera, renglones repetidos, pie)
POST {{host}}/api/render
Content-Type: application/json

{
  "template": {
    "page": { "size": "letter" },
    "header": {
      "height": 14,
      "elements": [
        { "type": "text", "x": 0, "y": 0, "width": 120, "height": 8, "value": "Pedido {{data.pedido}}", "fontSize": 14, "bold": true },
        { "type": "line", "x": 0, "y": 12, "width": 195.9, "color": "#999999" }
      ]
    },
    "sections": [
      {
        "name": "renglones",
        "height": 7,
        "dataSource": "data.items",
        "elements": [
          { "type": "text", "x": 0, "y": 1, "width": 10, "height": 5, "value": "{{rowNumber}}" },
          { "type": "text", "x": 12, "y": 1, "width": 120, "height": 5, "value": "{{row.descripcion}}" },
          { "type": "text", "x": 150, "y": 1, "width": 45, "height": 5, "value": "{{formatCurrency(row.importe)}}", "align": "right" }
        ]
      },
      {
        "name": "total",
        "height": 10,
        "elements": [
          { "type": "text", "x": 100, "y": 2, "width": 95, "height": 6, "value": "Total: {{formatCurrency(sum(data.items, \"importe\"))}}", "bold": true, "align": "right" }
        ]
      }
    ],
    "footer": {
      "height": 6,
      "elements": [
        { "type": "text", "x": 0, "y": 1, "width": 195.9, "height": 4, "value": "Página {{sys.pageNumber}} de {{sys.totalPages}}", "fontSize": 7, "align": "right" }
      ]
    }
  },
  "data": {
    "pedido": "P-001",
    "items": [
      { "descripcion": "Producto A", "importe": 120.5 },
      { "descripcion": "Producto B", "importe": 80 }
    ]
  }
}

### Vista previa PNG (página 1)
POST {{host}}/api/render/preview?page=1&dpi=96
Content-Type: application/json

{
  "template": { "elements": [ { "type": "text", "width": 100, "height": 8, "value": "Hola {{cliente.nombre}}" } ] },
  "data": { "cliente": { "nombre": "Mundo" } }
}

### CFDI: PDF con la plantilla incluida (XML directo en el body)
POST {{host}}/api/cfdi/render
Content-Type: application/xml

< ../../samples/cfdi/factura-ejemplo.xml

### CFDI: JSON que recibe la plantilla (para diseñar plantillas propias)
POST {{host}}/api/cfdi/data
Content-Type: application/xml

< ../../samples/cfdi/factura-ejemplo.xml

### Plantillas incluidas
GET {{host}}/api/templates/builtin

###
GET {{host}}/api/templates/builtin/cfdi-factura

############################################################
# API v1: plantillas guardadas en PostgreSQL (con versiones)
# Reemplaza @templateId con el id que devuelve la creación.
############################################################
@templateId = 00000000-0000-0000-0000-000000000000

### Crear plantilla (versión 1)
POST {{host}}/api/v1/templates
Content-Type: application/json

{
  "name": "Saludo",
  "description": "Ejemplo mínimo",
  "definition": {
    "sections": [
      { "height": 12, "elements": [ { "type": "text", "width": 120, "height": 8, "value": "Hola {{data.nombre}}", "fontSize": 14 } ] }
    ]
  },
  "sampleData": { "nombre": "Mundo" }
}

### Crear a partir de una plantilla incluida
POST {{host}}/api/v1/templates/from-builtin
Content-Type: application/json

{ "builtIn": "cfdi-factura", "name": "Factura CFDI" }

### Listar (búsqueda, paginación, incluir archivadas)
GET {{host}}/api/v1/templates?search=factura&page=1&pageSize=20&includeArchived=false

### Detalle (definición de la versión más reciente)
GET {{host}}/api/v1/templates/{{templateId}}

### Guardar versión nueva
PUT {{host}}/api/v1/templates/{{templateId}}
Content-Type: application/json

{
  "comment": "Texto más grande",
  "definition": {
    "sections": [
      { "height": 14, "elements": [ { "type": "text", "width": 120, "height": 10, "value": "Hola {{data.nombre}}", "fontSize": 20, "bold": true } ] }
    ]
  }
}

### Historial de versiones
GET {{host}}/api/v1/templates/{{templateId}}/versions

### Publicar la versión 1 (se usa por defecto al generar)
POST {{host}}/api/v1/templates/{{templateId}}/publish
Content-Type: application/json

{ "version": 1 }

### Restaurar la versión 1 como versión nueva
POST {{host}}/api/v1/templates/{{templateId}}/versions/1/restore

### Generar PDF (versión publicada; sin data usa los datos de prueba)
POST {{host}}/api/v1/documents
Content-Type: application/json

{ "templateId": "{{templateId}}", "data": { "nombre": "ACCloud" } }

### Vista previa PNG de una versión específica
POST {{host}}/api/v1/documents
Content-Type: application/json

{ "templateId": "{{templateId}}", "version": 2, "format": "png", "page": 1, "dpi": 96 }

### CFDI con plantilla guardada
POST {{host}}/api/cfdi/render?templateId={{templateId}}
Content-Type: application/xml

< ../../samples/cfdi/factura-ejemplo.xml

### Archivar
DELETE {{host}}/api/v1/templates/{{templateId}}
